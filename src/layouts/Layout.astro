---
import "@fontsource-variable/montserrat";

interface Props {
  title: string;
}

const { title } = Astro.props;
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
const siteUrl = new URL(
  baseUrl,
  Astro.site ?? new URL("https://ahmedsawwah.github.io"),
).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta
      name="description"
      content="Ahmed El-Sawwah - Software Developer building interactive and seamless digital experiences with cutting-edge frontend development."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}saw-favicon-xl.png`} />
    <link rel="canonical" href={siteUrl} />

    <meta
      property="og:title"
      content="Ahmed El-Sawwah | Software Developer"
    />
    <meta
      property="og:description"
      content="Portfolio of Ahmed El-Sawwah, Software Developer specializing in frontend and interactive experiences."
    />
    <meta
      property="og:image"
      content={`${siteUrl}saw-favicon-xl.png`}
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Ahmed El-Sawwah Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Ahmed El-Sawwah",
        "alternateName": "Ahmed El-Sawwah",
        "url": "https://ahmedsawwah.github.io/AELSA-Portfolio/",
        "image": "https://ahmedsawwah.github.io/AELSA-Portfolio/favicon.png",
        "sameAs": [
          "https://github.com",
          "https://linkedin.com"
        ],
        "jobTitle": "Software Developer",
        "description": "Software Developer building interactive and seamless digital experiences."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>

  @font-face {
    font-family: "Geraldine";
    src:
      url("/fonts/GeraldinePersonalUseItalic-PK12m.ttf") format("truetype"),
      url("/AELSA-Portfolio/fonts/GeraldinePersonalUseItalic-PK12m.ttf") format("truetype");
    font-display: swap;
    font-style: italic;
    font-weight: 400;
  }

  :root {
    --background: #050505;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  .section-title-gradient {
    width: fit-content;
    background: linear-gradient(90deg, #3f8f4d 0%, #73c982 52%, #9ae5a7 100%);
    background-clip: text;
    color: transparent !important;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-title-gradient:not(#thoughts-title) {
    font-size: clamp(1.55rem, 2.4vw, 2rem) !important;
    line-height: 1.1;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
