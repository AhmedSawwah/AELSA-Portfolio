---
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto md:pt-36 pb-14">
    <div class="text-left">
      <div class="flex w-full flex-col items-start gap-6 lg:w-[340px]">
        <div class="profile-photo-frame self-center" aria-hidden="true">
          <div class="profile-photo-inner">
            <img
              src={`${baseUrl}images/ahmed-profile.jpg`}
              alt=""
              width="720"
              height="720"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <h1
          class="w-full text-[var(--white)] text-4xl md:text-5xl font-medium text-pretty leading-none"
        >
          Ahmed <br /> El-Sawwah
        </h1>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a
          target="_blank"
          href="https://github.com/AhmedSawwah"
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="https://www.linkedin.com/in/ahmed-elsawwah-bb22a130a"
          aria-label="LinkedIn"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="mailto:aelsawwah@yahoo.com"
          aria-label="Email"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2.1em"
            height="2.1em"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a>
      </div>

      <section class="about-reference" aria-labelledby="about-heading">
        <h2 id="about-heading" class="about-reference__title">About Me</h2>

        <div class="about-reference__grid">
          <article class="about-reference__card">
          <p class="about-reference__intro">Hi, I’m Ahmed!</p>

          <p class="about-reference__body">
            I study Computer Science at Queen’s University, specializing in Artificial Intelligence, with interests in machine learning, networking, and building full-stack systems. My interest in computer science began when a friend told me I could be hacked on unsecured public Wi-Fi. My first thought was, “How?” That question introduced me to basic networking concepts and sent me down a rabbit hole I’m still exploring today.
          </p>

          <p class="about-reference__body about-reference__body--last">
            Outside of coding, I enjoy thought provoking games like chess, and learning about paradoxes. I’m drawn to anything involving strategy and psychology. Fun fact: I’ve memorized the flags of all 193 UN member countries, plus a few territories!
            <a class="about-reference__thoughts" href={`${baseUrl}thoughts/`}>
              <span>Inside My Mind</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>
          </p>

          <p class="about-reference__label about-reference__label--education">Education</p>
          <div class="about-reference__education">
            <div class="about-reference__education-card">
              <div class="about-reference__education-logo">
                <img
                  src={`${baseUrl}images/queens.png`}
                  alt=""
                  width="46"
                  height="46"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="about-reference__education-info">
                <strong>Queen’s University</strong>
                <span>
                  Bachelor of Computing (Honours) · Artificial Intelligence Specialization · 2024–2028
                </span>
              </div>
            </div>

            <div class="about-reference__education-card">
              <div class="about-reference__education-logo">
                <img
                  src={`${baseUrl}images/queens.png`}
                  alt=""
                  width="46"
                  height="46"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="about-reference__education-info">
                <strong>Queen’s University</strong>
                <span>Minor in Linguistics · 2024–2028</span>
              </div>
            </div>
          </div>

          <div class="about-reference__divider"></div>

          <div class="about-reference__interests">
            <p class="about-reference__label">Interests</p>
            <div class="about-reference__interest-tags" aria-label="Interests">
              <span>AI</span>
              <span>Data Science</span>
              <span>Software Engineering</span>
              <span>Sports Analytics</span>
              <span>Machine Learning</span>
            </div>
          </div>
          </article>

          <aside class="about-reference__photos" aria-labelledby="about-gallery-heading">
            <p id="about-gallery-heading" class="about-reference__gallery-label">
              Some photos of me!
            </p>

            <div
              class="about-reference__gallery"
              role="region"
              aria-label="Photos of Ahmed"
              data-about-gallery
            >
              <div class="about-reference__gallery-view" aria-live="polite">
                <figure
                  class="about-reference__gallery-item is-active"
                  data-gallery-item
                  aria-hidden="false"
                >
                  <img
                    src={`${baseUrl}images/ahmed-profile.jpg`}
                    alt="Ahmed sitting on a bench at Queen’s University"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="about-reference__gallery-caption">
                    Queen’s campus
                  </figcaption>
                </figure>

                <figure
                  class="about-reference__gallery-item"
                  data-gallery-item
                  aria-hidden="true"
                >
                  <img
                    class="about-reference__gallery-image--childhood"
                    src={`${baseUrl}images/ahmed-childhood.jpg`}
                    alt="Ahmed smiling as a child"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="about-reference__gallery-caption">
                    A little earlier
                  </figcaption>
                </figure>

                <button
                  type="button"
                  class="about-reference__gallery-arrow about-reference__gallery-arrow--prev"
                  aria-label="Previous photo"
                  data-gallery-prev
                >
                  <span aria-hidden="true">‹</span>
                </button>
                <button
                  type="button"
                  class="about-reference__gallery-arrow about-reference__gallery-arrow--next"
                  aria-label="Next photo"
                  data-gallery-next
                >
                  <span aria-hidden="true">›</span>
                </button>
              </div>

              <div class="about-reference__gallery-dots" role="tablist" aria-label="Choose photo">
                <button
                  type="button"
                  class="about-reference__gallery-dot is-active"
                  aria-label="Show photo 1"
                  aria-selected="true"
                  role="tab"
                  data-gallery-dot
                ></button>
                <button
                  type="button"
                  class="about-reference__gallery-dot"
                  aria-label="Show photo 2"
                  aria-selected="false"
                  role="tab"
                  data-gallery-dot
                ></button>
              </div>
            </div>
          </aside>
        </div>
      </section>
    </div>

    <LogoWall />

    <div
      class="relative left-1/2 w-[min(1150px,calc(100vw-2rem))] -translate-x-1/2 py-12 md:py-[72px]"
    >
      <SkillsList />
    </div>
  </div>
</section>


<script>
  const aboutGallery = document.querySelector<HTMLElement>("[data-about-gallery]");

  if (aboutGallery) {
    const items = Array.from(
      aboutGallery.querySelectorAll<HTMLElement>("[data-gallery-item]"),
    );
    const dots = Array.from(
      aboutGallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"),
    );
    const previous = aboutGallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const next = aboutGallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    let activeIndex = 0;

    const showPhoto = (index: number) => {
      activeIndex = (index + items.length) % items.length;

      items.forEach((item, itemIndex) => {
        const isActive = itemIndex === activeIndex;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-hidden", String(!isActive));
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle("is-active", isActive);
        dot.setAttribute("aria-selected", String(isActive));
      });
    };

    previous?.addEventListener("click", () => showPhoto(activeIndex - 1));
    next?.addEventListener("click", () => showPhoto(activeIndex + 1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => showPhoto(index)));
  }
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap");

  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
  .profile-photo-frame {
    position: relative;
    display: grid;
    width: 220px;
    height: 220px;
    flex: none;
    place-items: center;
    border-radius: 50%;
    isolation: isolate;
  }

  .profile-photo-frame::before {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(
      #58b368 0deg 29deg,
      transparent 29deg 36deg,
      #73c982 36deg 65deg,
      transparent 65deg 72deg,
      #3f8f4d 72deg 101deg,
      transparent 101deg 108deg,
      #8bdd99 108deg 137deg,
      transparent 137deg 144deg,
      #58b368 144deg 173deg,
      transparent 173deg 180deg,
      #73c982 180deg 209deg,
      transparent 209deg 216deg,
      #3f8f4d 216deg 245deg,
      transparent 245deg 252deg,
      #8bdd99 252deg 281deg,
      transparent 281deg 288deg,
      #58b368 288deg 317deg,
      transparent 317deg 324deg,
      #73c982 324deg 353deg,
      transparent 353deg 360deg
    );
    content: "";
    animation: profile-ring-spin 10s linear infinite;
  }

  .profile-photo-inner {
    position: relative;
    z-index: 1;
    width: calc(100% - 10px);
    height: calc(100% - 10px);
    overflow: hidden;
    border: 2px solid var(--background);
    border-radius: 50%;
    background: var(--background);
  }

  .profile-photo-inner img {
    object-position: 50% 50%;
    transform: scale(1.03);
  }

  @keyframes profile-ring-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-photo-frame::before {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .profile-photo-frame {
      width: 250px;
      height: 250px;
    }
  }

  .about-reference,
  .about-reference * {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .about-reference {
    position: relative;
    left: 50%;
    width: min(1150px, calc(100vw - 2rem));
    padding: 36px 0 72px;
    transform: translateX(-50%);
  }

  .about-reference__title {
    margin: 0 0 28px;
    color: #f4efe7;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .about-reference__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 22px;
    align-items: start;
  }

  .about-reference__card,
  .about-reference__photos {
    width: 100%;
    padding: 28px;
    border: 1px solid #3a352d;
    border-radius: 12px;
    background: #1d1d1d;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition:
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms ease,
      box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .about-reference__photos {
    align-self: center;
  }

  .about-reference__card:hover,
  .about-reference__photos:hover {
    border-color: #756f66;
    transform: translateY(-8px);
    box-shadow:
      0 24px 64px rgba(0, 0, 0, 0.35),
      0 0 0 1px #59544c;
  }

  .about-reference__intro {
    margin: 0 0 16px;
    color: #f4efe7;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .about-reference__body {
    margin: 0 0 14px;
    color: #c7bfb3;
    font-size: 0.97rem;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0;
  }

  .about-reference__body--last {
    margin-bottom: 0;
  }

  .about-reference__thoughts {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 8px;
    padding: 3px 8px;
    border: 1px solid #58b36866;
    border-radius: 8px;
    color: #73c982;
    background: #58b36814;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
    vertical-align: middle;
    white-space: nowrap;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background 200ms ease;
  }

  .about-reference__thoughts:hover,
  .about-reference__thoughts:focus-visible {
    border-color: #58b368b3;
    color: #9ae5a7;
    background: #58b36824;
    outline: none;
  }

  .about-reference__divider {
    height: 1px;
    margin: 20px 0;
    background: #3a352d;
  }

  .about-reference__label {
    margin: 0 0 12px;
    color: #c7bfb3;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .about-reference__label--education {
    margin-top: 16px;
  }

  .about-reference__education {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .about-reference__education-card {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid #3a352d;
    border-radius: 12px;
    background: #222222;
  }

  .about-reference__education-logo {
    display: grid;
    width: 54px;
    height: 54px;
    flex: 0 0 54px;
    place-items: center;
  }

  .about-reference__education-logo img {
    display: block;
    width: 46px;
    height: 46px;
    object-fit: contain;
  }

  .about-reference__education-info {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .about-reference__education-info strong {
    color: #f4efe7;
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .about-reference__education-info span {
    color: #c7bfb3;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .about-reference__interests {
    display: grid;
    gap: 10px;
  }

  .about-reference__interests .about-reference__label {
    margin-bottom: 0;
  }

  .about-reference__interest-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .about-reference__interest-tags span {
    padding: 6px 10px;
    border: 1px solid #3a352d;
    border-radius: 999px;
    color: #f4efe7;
    background: #222222;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
  }


  .about-reference__gallery-label {
    margin: 0 0 12px;
    color: #c7bfb3;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .about-reference__gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-reference__gallery-view {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid #3a352d;
    border-radius: 14px;
    background: #222222;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .about-reference__gallery-view::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.35), transparent 50%);
    content: "";
    pointer-events: none;
  }

  .about-reference__gallery-item {
    position: absolute;
    display: grid;
    align-items: end;
    margin: 0;
    opacity: 0;
    inset: 0;
    transition: opacity 450ms ease;
  }

  .about-reference__gallery-item.is-active {
    z-index: 1;
    opacity: 1;
  }

  .about-reference__gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 600ms ease;
  }

  .about-reference__gallery-item.is-active img {
    transform: scale(1.03);
  }

  .about-reference__gallery-item .about-reference__gallery-image--childhood {
    object-position: center 68%;
  }

  .about-reference__gallery-caption {
    position: relative;
    z-index: 3;
    width: fit-content;
    margin: 0 12px 12px;
    padding: 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.45);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    backdrop-filter: blur(10px);
  }

  .about-reference__gallery-arrow {
    position: absolute;
    z-index: 4;
    top: 50%;
    display: grid;
    width: 36px;
    height: 36px;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    color: #111111;
    background: rgba(255, 255, 255, 0.82);
    font-size: 1.55rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    backdrop-filter: blur(10px);
    transition:
      background 200ms ease,
      transform 200ms ease;
  }

  .about-reference__gallery-arrow:hover,
  .about-reference__gallery-arrow:focus-visible {
    background: rgba(255, 255, 255, 0.96);
    outline: none;
    transform: translateY(-50%) scale(1.08);
  }

  .about-reference__gallery-arrow--prev {
    left: 10px;
  }

  .about-reference__gallery-arrow--next {
    right: 10px;
  }

  .about-reference__gallery-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  .about-reference__gallery-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 1px solid #3a352d;
    border-radius: 999px;
    background: #222222;
    opacity: 0.5;
    cursor: pointer;
