  </div>
</section>


<script>
  const photoStacks = document.querySelectorAll<HTMLElement>("[data-photo-stack]");

  photoStacks.forEach((photoStack) => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const swipeThreshold = 86;

    const cards = () =>
      Array.from(photoStack.querySelectorAll<HTMLButtonElement>("[data-photo-card]"));

    const syncStack = () => {
      const stackCards = cards();
      const count = stackCards.length;

      stackCards.forEach((card, index) => {
        const randomRotation = Number(card.dataset.randomRotation ?? 0);
        const scale = 1 + index * 0.06 - count * 0.06;
        const rotation = (count - index - 1) * 4 + randomRotation;
        const isTopCard = index === count - 1;

        card.style.zIndex = String(index + 1);
        card.style.setProperty("--stack-scale", scale.toFixed(2));
        card.style.setProperty("--stack-rotation", `${rotation.toFixed(2)}deg`);
        card.tabIndex = isTopCard ? 0 : -1;
        card.setAttribute("aria-hidden", String(!isTopCard));
      });
    };

    const returnToStack = (card: HTMLButtonElement) => {
      card.classList.remove("is-dragging");
      card.style.transition = reducedMotion.matches
        ? "none"
        : "transform 440ms cubic-bezier(0.22, 1.35, 0.36, 1)";
      card.style.transform = "";
    };

    const sendToBack = (
      card: HTMLButtonElement,
      directionX = 1,
      directionY = 0,
    ) => {
      if (card !== cards().at(-1) || card.dataset.animating === "true") return;

      card.dataset.animating = "true";
      card.classList.remove("is-dragging");

      const width = photoStack.getBoundingClientRect().width;
      const xSign = directionX === 0 ? 1 : Math.sign(directionX);
      const exitX = xSign * Math.max(width * 1.15, 220);
      const exitY = Math.max(-80, Math.min(80, directionY * 0.6));
      const exitRotation = xSign * 18;

      card.style.transition = reducedMotion.matches
        ? "none"
        : "transform 280ms cubic-bezier(0.4, 0, 1, 1), opacity 220ms ease";
      card.style.transform = `translate3d(${exitX}px, ${exitY}px, 0) rotateZ(${exitRotation}deg)`;
      card.style.opacity = reducedMotion.matches ? "1" : "0";

      window.setTimeout(() => {
        const firstCard = cards()[0];
        photoStack.insertBefore(card, firstCard ?? null);
        card.style.transition = "none";
        card.style.transform = "";
        card.style.opacity = "1";
        delete card.dataset.animating;
        syncStack();

        window.requestAnimationFrame(() => {
          card.style.transition = "";
        });
      }, reducedMotion.matches ? 0 : 285);
    };

    cards().forEach((card) => {
      let pointerId: number | null = null;
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let deltaY = 0;
      let moved = false;
      let suppressClick = false;

      card.addEventListener("pointerdown", (event) => {
        if (card !== cards().at(-1) || card.dataset.animating === "true") return;

        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        deltaX = 0;
        deltaY = 0;
        moved = false;
        card.classList.add("is-dragging");
        card.style.transition = "none";
        card.setPointerCapture(pointerId);
        event.preventDefault();
      });

      card.addEventListener("pointermove", (event) => {
        if (event.pointerId !== pointerId) return;

        deltaX = event.clientX - startX;
        deltaY = event.clientY - startY;
        const distance = Math.hypot(deltaX, deltaY);
        moved = moved || distance > 5;

        const rotateX = Math.max(-18, Math.min(18, -deltaY * 0.12));
        const rotateY = Math.max(-18, Math.min(18, deltaX * 0.12));
        card.style.transform = `translate3d(${deltaX}px, ${deltaY}px, 0) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });

      const finishPointer = (event: PointerEvent) => {
        if (event.pointerId !== pointerId) return;

        if (card.hasPointerCapture(pointerId)) card.releasePointerCapture(pointerId);
        pointerId = null;
        suppressClick = true;
        window.setTimeout(() => {
          suppressClick = false;
        }, 0);

        if (Math.hypot(deltaX, deltaY) >= swipeThreshold) {
          sendToBack(card, deltaX, deltaY);
        } else if (!moved) {
          sendToBack(card);
        } else {
          returnToStack(card);
        }
      };

      card.addEventListener("pointerup", finishPointer);
      card.addEventListener("pointercancel", (event) => {
        if (event.pointerId !== pointerId) return;
        pointerId = null;
        returnToStack(card);
      });

      card.addEventListener("click", (event) => {
        if (event.detail > 0) {
          if (suppressClick) event.preventDefault();
          return;
        }
        sendToBack(card);
      });
    });

    syncStack();
  });
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap");

  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
  .intro-reference,
  .intro-reference * {
    box-sizing: border-box;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .intro-reference {
    position: relative;
    left: 50%;
    display: grid;
    width: min(1150px, calc(100vw - 2rem));
    min-height: clamp(460px, 64vh, 620px);
    align-items: center;
    padding: 20px 0 0;
    transform: translateX(-50%);
  }

  .intro-reference__layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
  }

  .intro-reference__kicker {
    margin: 0 0 10px;
    color: #c7bfb3;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro-reference__title {
    margin: 0;
    color: #f4efe7;
    font-size: clamp(2.2rem, 5vw, 4.1rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .intro-reference__subtitle {
    margin: 10px 0 0;
    color: #c7bfb3;
    font-size: 1.08rem;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0;
  }

  .intro-reference__description {
    max-width: 650px;
    margin: 16px 0 0;
    color: #c7bfb3;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: -0.01em;
  }

  .intro-reference__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .intro-reference__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 9px 12px;
    border: 1px solid #58b36866;
    border-radius: 8px;
    color: #73c982;
    background: #58b36814;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0;
    text-decoration: none;
    transition:
      color 250ms ease,
      background 250ms ease,
      transform 250ms ease;
  }

  .intro-reference__button svg {
    display: block;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  .intro-reference__button:hover,
  .intro-reference__button:focus-visible {
    border-color: #58b368b3;
    color: #9ae5a7;
    background: #58b36824;
    outline: none;
    transform: translateY(-2px);
  }

  .intro-reference__signature {
    position: relative;
    width: max-content;
    max-width: 100%;
    margin-top: 18px;
    padding-right: 56px;
    border-right: 2px solid #73c982;
    color: #73c982;
    font-family: "Segoe Script", "Brush Script MT", cursive;
    font-size: 1.85rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0;
    white-space: nowrap;
    animation: intro-signature-blink 700ms step-end infinite;
  }

  .intro-reference__socials {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }

  .intro-reference__social {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid #3a352d;
    border-radius: 10px;
    color: #f4efe7;
    background: #1d1d1d;
    text-decoration: none;
    transition:
      color 250ms ease,
      border-color 250ms ease,
      transform 250ms ease;
  }

  .intro-reference__social svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .intro-reference__social:hover,
