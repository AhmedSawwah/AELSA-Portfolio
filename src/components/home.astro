                <button type="button" class="about-stack__item" data-photo-card data-random-rotation="3.6" aria-label="Ahmed as a child sitting at a restaurant">
                  <span class="about-stack__card">
                    <img src={`${baseUrl}images/ahmed-early-3.webp`} alt="Ahmed as a child sitting at a restaurant" loading="lazy" decoding="async" draggable="false" />
                  </span>
                </button>

                <button type="button" class="about-stack__item" data-photo-card data-random-rotation="-2.2" aria-label="Ahmed as a child at a birthday celebration">
                  <span class="about-stack__card">
                    <img src={`${baseUrl}images/ahmed-early-2.webp`} alt="Ahmed as a child at a birthday celebration" loading="lazy" decoding="async" draggable="false" />
                  </span>
                </button>

                <button type="button" class="about-stack__item" data-photo-card data-random-rotation="1.4" aria-label="Ahmed as a child standing by a doorway">
                  <span class="about-stack__card">
                    <img src={`${baseUrl}images/ahmed-early-1.webp`} alt="Ahmed as a child standing by a doorway" loading="lazy" decoding="async" draggable="false" />
                  </span>
