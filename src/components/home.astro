---
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
---

<section class="text-[var(--white)]" id="home">
  <div class="max-w-5xl mx-auto pb-14">
    <div class="text-left">
      <header class="intro-reference" aria-labelledby="intro-heading">
        <div class="intro-reference__layout">
          <div class="intro-reference__left">
            <h1 id="intro-heading" class="intro-reference__title">
              Ahmed El-Sawwah
            </h1>
            <p class="intro-reference__description">
              Full-stack software developer and aspiring AI/ML engineer with experience
              building end-to-end applications, designing scalable backend systems, and
              creating intelligent features powered by machine learning. I enjoy turning
              complex problems into practical, user-focused software that is reliable,
              efficient, and easy to use.
            </p>

            <div class="intro-reference__buttons">
              <a href="#projects" class="intro-reference__button">
                <span>Explore Projects</span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14"></path>
                  <path d="m19 12-7 7-7-7"></path>
                </svg>
              </a>
              <a href="#contact" class="intro-reference__button">Get In Touch</a>
              <a
                href="#contact"
                class="intro-reference__button"
                aria-label="Request Ahmed’s resume"
              >
                My Resume
              </a>
            </div>

            <div class="intro-reference__signature" aria-label="Ahmed El-Sawwah signature">
              Ahmed El-Sawwah
            </div>

            <div class="intro-reference__socials" aria-label="Social links">
              <a
                href="https://www.linkedin.com/in/ahmed-elsawwah-bb22a130a"
                target="_blank"
                rel="noopener noreferrer"
                class="intro-reference__social"
                aria-label="LinkedIn"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
