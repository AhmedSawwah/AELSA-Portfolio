                    <img src={`${baseUrl}images/ahmed-early-5.webp`} alt="Ahmed as a child sitting in a car seat" loading="lazy" decoding="async" draggable="false" />
                  </span>
                </button>

                <button type="button" class="about-stack__item" data-photo-card data-random-rotation="-1.8" aria-label="Ahmed smiling as a child">
                  <span class="about-stack__card">
                    <img src={`${baseUrl}images/ahmed-early-4.webp`} alt="Ahmed smiling as a child" loading="lazy" decoding="async" draggable="false" />
                  </span>
