---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-left space-y-4">
      <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
        Hi, my name is
      </p>
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <div class="flex w-full flex-col items-start gap-6 lg:w-[340px] lg:flex-shrink-0">
          <div class="profile-photo-frame self-center" aria-hidden="true">
            <div class="profile-photo-inner">
              <img
                src={`${baseUrl}images/ahmed-profile.jpg`}
                alt=""
                width="443"
                height="960"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <h1
            class="w-full text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none"
          >
            Ahmed <br /> El-Sawwah
          </h1>
        </div>
        <div class="space-y-2 lg:flex-1">
          <h2 class="text-lg md:text-xl font-semibold text-[#58b368]">
            About Me:
          </h2>
          <div class="space-y-4">
            <p class="indent-8 text-sm md:text-lg leading-relaxed text-[var(--white-icon)]">
              I study Computer Science at Queen’s University, specializing in Artificial Intelligence, with interests in machine learning, networking, and building full-stack systems. My interest in computer science began when a friend told me I could be hacked on unsecured public Wi-Fi. My first thought was, “How?” That question introduced me to basic networking concepts and sent me down a rabbit hole I’m still exploring today.
            </p>
            <p class="indent-8 text-sm md:text-lg leading-relaxed text-[var(--white-icon)]">
              Outside of coding, I enjoy thought provoking games like chess, and learning about paradoxes. I’m drawn to anything involving strategy and psychology. Fun fact: I’ve memorized the flags of all 193 UN member countries, plus a few territories!
            </p>
          </div>
          <a
            href={`${baseUrl}thoughts/`}
            class="mt-5 inline-flex items-center gap-2 rounded-lg border border-[#58b36866] bg-[#58b36814] px-4 py-2.5 text-sm font-semibold text-[#73c982] transition-colors hover:border-[#58b368b3] hover:bg-[#58b36824] hover:text-[#8bdd99] md:text-base"
          >
            <span>Inside My Mind</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a
          target="_blank"
          href="https://github.com/AhmedSawwah"
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="https://www.linkedin.com/in/ahmed-elsawwah-bb22a130a"
          aria-label="LinkedIn"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="mailto:aelsawwah@yahoo.com"
          aria-label="Email"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2.1em"
            height="2.1em"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#003b00", "#00ff41", "#0d1b0d"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
  .profile-photo-frame {
    position: relative;
    display: grid;
    width: 220px;
    height: 220px;
    flex: none;
    place-items: center;
    border-radius: 50%;
    isolation: isolate;
    box-shadow: 0 0 30px rgba(88, 179, 104, 0.16);
  }

  .profile-photo-frame::before {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(
      #58b368 0deg 48deg,
      transparent 48deg 61deg,
      #73c982 61deg 126deg,
      transparent 126deg 141deg,
      #3f8f4d 141deg 205deg,
      transparent 205deg 221deg,
      #8bdd99 221deg 282deg,
      transparent 282deg 297deg,
      #58b368 297deg 347deg,
      transparent 347deg 360deg
    );
    content: "";
    animation: profile-ring-spin 10s linear infinite;
  }

  .profile-photo-inner {
    position: relative;
    z-index: 1;
    width: calc(100% - 14px);
    height: calc(100% - 14px);
    overflow: hidden;
    border: 4px solid var(--background);
    border-radius: 50%;
    background: var(--background);
  }

  .profile-photo-inner img {
    object-position: 50% 68%;
    transform: scale(1.03);
  }

  @keyframes profile-ring-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-photo-frame::before {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .profile-photo-frame {
      width: 250px;
      height: 250px;
    }
  }

</style>
