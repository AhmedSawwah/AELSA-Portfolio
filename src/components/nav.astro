---
interface NavItem {
  label: string;
  href: string;
  sectionId?: string;
}

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const normalizedBase = baseUrl.replace(/\/+$/, "") || "/";
const isHomePage = normalizedPath === normalizedBase;
const isThoughtsPage =
  normalizedPath === `${normalizedBase === "/" ? "" : normalizedBase}/thoughts`;
const sectionHref = (id: string) =>
  isHomePage ? `#${id}` : `${baseUrl}#${id}`;

const navItems: NavItem[] = [
  { label: "Home", href: sectionHref("home"), sectionId: "home" },
  { label: "Experience", href: sectionHref("experience"), sectionId: "experience" },
  { label: "Projects", href: sectionHref("projects"), sectionId: "projects" },
  { label: "Contact", href: sectionHref("contact"), sectionId: "contact" },
  { label: "Thoughts", href: `${baseUrl}thoughts/` },
];
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-nav__inner">
    <a
      href={sectionHref("home")}
      class="site-nav__brand"
      aria-label="Ahmed El-Sawwah home"
    >
      <span>Ahmed El-Sawwah</span>
    </a>

    <button
      id="mobile-menu-toggle"
      class="site-nav__toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="main-nav-links"
      aria-expanded="false"
    >
      <svg
        class="site-nav__menu-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
      <svg
        class="site-nav__close-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6 6 18"></path>
      </svg>
    </button>

    <ul id="main-nav-links" class="site-nav__links">
      {
        navItems.map((item) => {
          const isActive =
            (item.sectionId === "home" && isHomePage) ||
            (item.label === "Thoughts" && isThoughtsPage);

          return (
            <li>
              <a
                href={item.href}
                class:list={["site-nav__link", { active: isActive }]}
                data-section-id={item.sectionId}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    z-index: 1000;
    top: 0;
    margin-inline: -2.25rem;
    border-bottom: 1px solid #3a352d;
    background: rgba(19, 19, 19, 0.86);
    backdrop-filter: blur(10px);
  }

  .site-nav__inner {
    position: relative;
    display: flex;
    width: min(1150px, 92%);
    height: 68px;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
  }

  .site-nav__brand {
    position: absolute;
    top: 8px;
    left: calc(50% - 50vw + 20px);
    display: flex;
    width: 190px;
    height: 52px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-start;
    opacity: 0.92;
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }

  .site-nav__brand:hover,
  .site-nav__brand:focus-visible {
    opacity: 1;
    outline: none;
    transform: translateY(-1px);
  }

  .site-nav__brand span {
    display: block;
    color: #73c982;
    font-family: "Geraldine", "Segoe Script", "Brush Script MT", cursive;
    font-size: 1.8rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    color: #c7bfb3;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition:
      color 250ms ease,
      border-color 250ms ease;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: #f4efe7;
    outline: none;
  }

  .site-nav__link.active {
    border-bottom-color: #73c982;
    color: #73c982;
  }

  .site-nav__toggle {
    display: none;
    margin-left: auto;
  }

  @media (min-width: 640px) {
    .site-nav {
      margin-inline: -7rem;
    }
  }

  @media (min-width: 1024px) {
    .site-nav {
      margin-inline: -5rem;
    }
  }

  @media (max-width: 900px) {
    .site-nav__brand {
      width: 165px;
    }

    .site-nav__brand span {
      font-size: 1.55rem;
    }

    .site-nav__toggle {
      display: grid;
      width: 40px;
      height: 40px;
      padding: 0;
      place-items: center;
      border: 1px solid #3a352d;
      border-radius: 10px;
      color: #f4efe7;
      background: #1d1d1d;
      cursor: pointer;
      transition:
        color 200ms ease,
        border-color 200ms ease,
        background 200ms ease;
    }

    .site-nav__toggle:hover,
    .site-nav__toggle:focus-visible {
      border-color: #58b36880;
      color: #73c982;
      background: #222222;
      outline: none;
    }

    .site-nav__toggle svg {
      width: 22px;
      height: 22px;
    }

    .site-nav__close-icon {
      display: none;
    }

    .site-nav__toggle[aria-expanded="true"] .site-nav__menu-icon {
      display: none;
    }

    .site-nav__toggle[aria-expanded="true"] .site-nav__close-icon {
      display: block;
    }

    .site-nav__links {
      position: absolute;
      top: 78px;
      right: 0;
      display: flex;
      width: min(240px, calc(100vw - 2rem));
      max-height: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      overflow: hidden;
      padding: 0;
      border: 1px solid transparent;
      border-radius: 12px;
      background: rgba(29, 29, 29, 0.98);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.38);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        max-height 300ms ease,
        padding 300ms ease,
        border-color 300ms ease,
        opacity 200ms ease,
        transform 200ms ease;
    }

    .site-nav__links.open {
      max-height: 430px;
      padding: 10px;
      border-color: #3a352d;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-nav__link {
      display: block;
      width: 100%;
      padding: 10px 12px;
      border: 0;
      border-bottom: 2px solid transparent;
      border-radius: 8px;
      font-size: 0.9rem;
    }

    .site-nav__link:hover,
    .site-nav__link:focus-visible,
    .site-nav__link.active {
      padding-bottom: 10px;
      color: #73c982;
      background: rgba(88, 179, 104, 0.1);
    }

    .site-nav__link.active {
      border-bottom-color: #73c982;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__brand,
    .site-nav__link,
    .site-nav__toggle,
    .site-nav__links {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const links = document.getElementById("main-nav-links");

  const setMenuOpen = (open: boolean) => {
    links?.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute(
      "aria-label",
      open ? "Close navigation menu" : "Open navigation menu",
    );
  };

  toggle?.addEventListener("click", () => {
    setMenuOpen(!links?.classList.contains("open"));
  });

  links?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;

    if (
      links?.classList.contains("open") &&
      !links.contains(target) &&
      !toggle?.contains(target)
    ) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMenuOpen(false);
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) {
      setMenuOpen(false);
    }
  });

  const localLinks = Array.from(
    links?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? [],
  );

  if (localLinks.length) {
    const sections = localLinks
      .map((link) => {
        const id = link.dataset.sectionId;
        const section = id ? document.getElementById(id) : null;
        return id && section instanceof HTMLElement ? { id, section } : null;
      })
      .filter(
        (entry): entry is { id: string; section: HTMLElement } => entry !== null,
      );

    const activate = (id: string) => {
      localLinks.forEach((link) => {
        const isActive = link.dataset.sectionId === id;
        link.classList.toggle("active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    let navigationTargetId: string | null = null;
    let navigationTimer: number | undefined;
    let scrollFrame: number | null = null;

    const syncActiveSection = () => {
      scrollFrame = null;

      if (navigationTargetId) {
        const target = document.getElementById(navigationTargetId);
        const hasArrived = target && Math.abs(target.getBoundingClientRect().top) <= 110;

        if (!hasArrived) {
          activate(navigationTargetId);
          return;
        }

        navigationTargetId = null;
      }

      let activeId = sections[0]?.id;

      sections.forEach(({ id, section }) => {
        if (section.getBoundingClientRect().top <= 110) {
          activeId = id;
        }
      });

      if (activeId) {
        activate(activeId);
      }
    };

    const scheduleActiveSync = () => {
      if (scrollFrame === null) {
        scrollFrame = window.requestAnimationFrame(syncActiveSection);
      }
    };

    localLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const id = link.dataset.sectionId;
        const target = id ? document.getElementById(id) : null;

        if (!id || !target) return;

        event.preventDefault();
        navigationTargetId = id;
        activate(id);
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", `#${id}`);

        window.clearTimeout(navigationTimer);
        navigationTimer = window.setTimeout(() => {
          navigationTargetId = null;
          scheduleActiveSync();
        }, 1600);
      });
    });

    window.addEventListener("scroll", scheduleActiveSync, { passive: true });
    window.addEventListener("resize", scheduleActiveSync);
    window.addEventListener("hashchange", scheduleActiveSync);
    scheduleActiveSync();
  }
</script>
