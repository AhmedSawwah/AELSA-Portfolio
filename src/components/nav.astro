---
interface NavItem {
  label: string;
  href: string;
  sectionId?: string;
}

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const normalizedBase = baseUrl.replace(/\/+$/, "") || "/";
const isHomePage = normalizedPath === normalizedBase;
const isThoughtsPage =
  normalizedPath === `${normalizedBase === "/" ? "" : normalizedBase}/thoughts`;
const sectionHref = (id: string) =>
  isHomePage ? `#${id}` : `${baseUrl}#${id}`;

const navItems: NavItem[] = [
  { label: "Home", href: sectionHref("home"), sectionId: "home" },
  { label: "About", href: sectionHref("about"), sectionId: "about" },
  { label: "Experience", href: sectionHref("experience"), sectionId: "experience" },
  { label: "Projects", href: sectionHref("projects"), sectionId: "projects" },
  {
    label: "Technologies",
    href: sectionHref("technologies"),
    sectionId: "technologies",
  },
  { label: "Thoughts", href: `${baseUrl}thoughts/` },
  { label: "Contact", href: sectionHref("contact"), sectionId: "contact" },
];
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-nav__inner">
    <a
      href={sectionHref("home")}
      class="site-nav__brand"
      aria-label="Ahmed El-Sawwah home"
    >
      <img
        src={`${baseUrl}images/ahmed-signature.png`}
        alt="Ahmed El-Sawwah"
        width="373"
        height="139"
      />
    </a>

    <button
      id="mobile-menu-toggle"
      class="site-nav__toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="main-nav-links"
      aria-expanded="false"
    >
      <svg
        class="site-nav__menu-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
      <svg
        class="site-nav__close-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6 6 18"></path>
      </svg>
    </button>

    <ul id="main-nav-links" class="site-nav__links">
      {
        navItems.map((item) => {
          const isActive =
            (item.sectionId === "home" && isHomePage) ||
            (item.label === "Thoughts" && isThoughtsPage);

          return (
            <li>
              <a
                href={item.href}
                class:list={["site-nav__link", { active: isActive }]}
                data-section-id={item.sectionId}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    z-index: 1000;
    top: 0;
    margin-inline: -2.25rem;
    border-bottom: 1px solid #3a352d;
    background: rgba(19, 19, 19, 0.86);
    backdrop-filter: blur(10px);
  }

  .site-nav__inner {
    position: relative;
    display: flex;
    width: min(1150px, 92%);
    height: 68px;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
  }

  .site-nav__brand {
    display: flex;
    width: 150px;
    height: 52px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-start;
    opacity: 0.92;
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }

  .site-nav__brand:hover,
  .site-nav__brand:focus-visible {
    opacity: 1;
    outline: none;
    transform: translateY(-1px);
  }

  .site-nav__brand img {
    display: block;
    width: 145px;
    max-height: 50px;
    object-fit: contain;
    object-position: left center;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    color: #c7bfb3;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    text-decoration: none;
    transition:
      color 250ms ease,
      border-color 250ms ease;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: #f4efe7;
    outline: none;
  }

  .site-nav__link.active {
    padding-bottom: 4px;
    border-bottom: 2px solid #73c982;
    color: #73c982;
  }

  .site-nav__toggle {
    display: none;
  }

  @media (min-width: 640px) {
    .site-nav {
      margin-inline: -7rem;
    }
  }

  @media (min-width: 1024px) {
    .site-nav {
      margin-inline: -5rem;
    }
  }

  @media (max-width: 900px) {
    .site-nav__brand {
      width: 138px;
    }

    .site-nav__brand img {
      width: 132px;
    }

    .site-nav__toggle {
      display: grid;
      width: 40px;
      height: 40px;
      padding: 0;
      place-items: center;
      border: 1px solid #3a352d;
      border-radius: 10px;
      color: #f4efe7;
      background: #1d1d1d;
      cursor: pointer;
      transition:
        color 200ms ease,
        border-color 200ms ease,
        background 200ms ease;
    }

    .site-nav__toggle:hover,
    .site-nav__toggle:focus-visible {
      border-color: #58b36880;
      color: #73c982;
      background: #222222;
      outline: none;
    }

    .site-nav__toggle svg {
      width: 22px;
      height: 22px;
    }

    .site-nav__close-icon {
      display: none;
    }

    .site-nav__toggle[aria-expanded="true"] .site-nav__menu-icon {
      display: none;
    }

    .site-nav__toggle[aria-expanded="true"] .site-nav__close-icon {
      display: block;
    }

    .site-nav__links {
      position: absolute;
      top: 78px;
      right: 0;
      display: flex;
      width: min(240px, calc(100vw - 2rem));
      max-height: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      overflow: hidden;
      padding: 0;
      border: 1px solid transparent;
      border-radius: 12px;
      background: rgba(29, 29, 29, 0.98);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.38);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        max-height 300ms ease,
        padding 300ms ease,
        border-color 300ms ease,
        opacity 200ms ease,
        transform 200ms ease;
    }

    .site-nav__links.open {
      max-height: 430px;
      padding: 10px;
      border-color: #3a352d;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-nav__link {
      display: block;
      width: 100%;
      padding: 10px 12px;
      border: 0;
      border-radius: 8px;
      font-size: 0.9rem;
    }

    .site-nav__link:hover,
    .site-nav__link:focus-visible,
    .site-nav__link.active {
      padding-bottom: 10px;
      border: 0;
      color: #73c982;
      background: rgba(88, 179, 104, 0.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__brand,
    .site-nav__link,
    .site-nav__toggle,
    .site-nav__links {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const links = document.getElementById("main-nav-links");

  const setMenuOpen = (open: boolean) => {
    links?.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute(
      "aria-label",
      open ? "Close navigation menu" : "Open navigation menu",
    );
  };

  toggle?.addEventListener("click", () => {
    setMenuOpen(!links?.classList.contains("open"));
  });

  links?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;

    if (
      links?.classList.contains("open") &&
      !links.contains(target) &&
      !toggle?.contains(target)
    ) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMenuOpen(false);
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) {
      setMenuOpen(false);
    }
  });

  const localLinks = Array.from(
    links?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? [],
  );

  localLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const id = link.getAttribute("href")?.slice(1);
      const target = id ? document.getElementById(id) : null;

      if (!target) return;

      event.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      history.replaceState(null, "", `#${id}`);
    });
  });

  if (localLinks.length) {
    const sectionById = new Map(
      localLinks
        .map((link) => {
          const id = link.dataset.sectionId;
          return id ? [id, document.getElementById(id)] : null;
        })
        .filter(
          (entry): entry is [string, HTMLElement] =>
            Array.isArray(entry) && entry[1] instanceof HTMLElement,
        ),
    );

    const activate = (id: string) => {
      localLinks.forEach((link) => {
        const isActive = link.dataset.sectionId === id;
        link.classList.toggle("active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible?.target.id) {
          activate(visible.target.id);
        }
      },
      {
        rootMargin: "-20% 0px -65% 0px",
        threshold: [0, 0.15, 0.4, 0.7],
      },
    );

    sectionById.forEach((section) => observer.observe(section));
  }
</script>
