---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const normalizedBase = baseUrl.replace(/\/+$/, "") || "/";
const isHomePage = normalizedPath === normalizedBase;
const isThoughtsPage =
  normalizedPath === `${normalizedBase === "/" ? "" : normalizedBase}/thoughts`;
const sectionHref = (id: string) =>
  isHomePage ? `#${id}` : `${baseUrl}#${id}`;

const navItems: NavItem[] = [
  {
    label: "Home",
    href: sectionHref("home"),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "Projects",
    href: sectionHref("projects"),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "Contact",
    href: sectionHref("contact"),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
  {
    label: "Thoughts",
    href: `${baseUrl}thoughts/`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path><path d="M8 8h8"></path><path d="M8 12h6"></path></svg>`,
  },
];
---

<a
  href={sectionHref("home")}
  aria-label="Ahmed El-Sawwah home"
  class="absolute left-4 top-4 z-[101] block opacity-90 transition-opacity hover:opacity-100 md:left-6 md:top-6"
>
  <img
    src={`${baseUrl}images/ahmed-signature.png`}
    alt="Ahmed El-Sawwah"
    width="373"
    height="139"
    class="h-auto w-[132px] md:w-[92px] lg:w-[165px]"
  />
</a>

<button
  id="mobile-menu-toggle"
  class="mobile-menu-toggle"
  type="button"
  aria-label="Open navigation menu"
  aria-controls="main-nav"
  aria-expanded="false"
>
  <svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M4 7h16"></path>
    <path d="M4 12h16"></path>
    <path d="M4 17h16"></path>
  </svg>
  <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M6 6l12 12"></path>
    <path d="M18 6L6 18"></path>
  </svg>
</button>

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--background)] border border-1 border-transparent backdrop-blur-xl transition-colors duration-300 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[80%] max-w-[640px]"
  >
    <div class="container mx-auto flex justify-center items-center p-3">
      <ul
        class="grid w-full grid-cols-4 items-start"
      >
        {
          navItems.map((item) => (
            <li class="min-w-0">
              <a
                href={item.href}
                class:list={[
                  "flex w-full flex-col items-center gap-1 text-[var(--white-icon)] transition-colors text-xs md:text-base relative group",
                  { active: item.label === "Thoughts" && isThoughtsPage },
                ]}
                aria-current={item.label === "Thoughts" && isThoughtsPage ? "page" : undefined}
              >
                <span class="md:hidden flex items-center justify-center w-6 h-6">
                  <fragment set:html={item.icon} />
                </span>
                <span class="hidden items-center gap-2 md:inline-flex">
                  <span class="nav-indicator h-2 w-2 shrink-0 rounded-full bg-[#58b368] opacity-0 transition-all duration-300" />
                  <span>{item.label}</span>
                </span>
                <span class="md:hidden">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>
<style>
  nav {
    transform: translateX(-50%);
    background-color: var(--background);
    transition:
      background-color 0.3s ease,
      border-radius 0.3s ease,
      border-color 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--component-bg);
    border-color: #ffffff10;
    border-radius: 9999px;
  }

  .nav-indicator {
    transform: scale(0);
  }

  nav a.active .nav-indicator {
    transform: scale(1);
    opacity: 1;
  }

  nav a.active {
    color: white !important;
  }

  .mobile-menu-toggle {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-menu-toggle {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 102;
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border: 1px solid #ffffff18;
      border-radius: 8px;
      background: rgba(16, 16, 16, 0.94);
      color: var(--white-icon);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(14px);
      transition:
        border-color 0.2s ease,
        color 0.2s ease,
        background-color 0.2s ease;
    }

    .mobile-menu-toggle:hover,
    .mobile-menu-toggle:focus-visible {
      border-color: #58b36880;
      color: #73c982;
      outline: none;
    }

    .mobile-menu-toggle .close-icon {
      display: none;
    }

    .mobile-menu-toggle[aria-expanded="true"] .menu-icon {
      display: none;
    }

    .mobile-menu-toggle[aria-expanded="true"] .close-icon {
      display: block;
    }

    #main-nav {
      position: fixed;
      top: 4.75rem;
      right: 1rem;
      bottom: auto;
      left: auto;
      width: min(240px, calc(100vw - 2rem)) !important;
      max-width: 240px;
      border-color: #ffffff14;
      border-radius: 8px;
      background: rgba(16, 16, 16, 0.96);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.38);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0.2s ease;
    }

    #main-nav.mobile-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    #main-nav.scrolling {
      border-radius: 8px;
      background: rgba(16, 16, 16, 0.96);
    }

    #main-nav > div {
      padding: 0.5rem;
    }

    #main-nav ul {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    #main-nav a {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.75rem;
      padding: 0.75rem;
      border-radius: 8px;
      font-size: 0.875rem;
    }

    #main-nav a:hover,
    #main-nav a.active {
      background: rgba(88, 179, 104, 0.1);
      color: #73c982 !important;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
  let rafId: number | null = null;

  function setMobileMenu(open: boolean) {
    nav?.classList.toggle("mobile-open", open);
    mobileMenuToggle?.setAttribute("aria-expanded", String(open));
    mobileMenuToggle?.setAttribute(
      "aria-label",
      open ? "Close navigation menu" : "Open navigation menu"
    );
  }

  mobileMenuToggle?.addEventListener("click", () => {
    setMobileMenu(!nav?.classList.contains("mobile-open"));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMobileMenu(false));
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (
      nav?.classList.contains("mobile-open") &&
      !nav.contains(target) &&
      !mobileMenuToggle?.contains(target)
    ) {
      setMobileMenu(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMobileMenu(false);
      mobileMenuToggle?.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) {
      setMobileMenu(false);
    }
  });

  function updateNav() {
    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");

    } else {
      nav?.classList.remove("scrolling");
      nav?.style.setProperty("width", "80%");
    }
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true }
  );

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const targetId = target.getAttribute("href")?.substring(1) || "";
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a[href^='#']");
    const observerOptions = { threshold: 0.6 };

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove("active"));
          const id = entry.target.getAttribute("id");
          const activeLink = document.querySelector(`nav a[href="#${id}"]`);
          if (activeLink) {
            activeLink.classList.add("active");
          }
        }
      });
    };

    const observer = new IntersectionObserver(
      observerCallback,
      observerOptions
    );
    sections.forEach((section) => observer.observe(section));
  });
</script>

<style>
  nav a.active {
    color: white !important;
  }
</style>
